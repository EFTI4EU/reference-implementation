# Domibus 5.2.1 as a plain Tomcat container.
#
# The official code.europa.eu domibus-tomcat10 image is a self-provisioning appliance: on first boot
# its entrypoint *generates* the domain layout, keystores, logback and properties from environment
# variables (DOMAINS_COUNT / DOMAIN_ALIASES / ...), and overwrites whatever is mounted underneath.
# That is the opposite of what this deployment needs, since our configuration and certificates are
# predefined and version controlled.
#
# So we use that image only as a *build* stage: its provisioning routine is run once, here, to lay
# out a pristine Domibus 5.2.1 configuration skeleton and deploy the WAR. The runtime image then
# just starts Tomcat, with no provisioning logic at all - the same model as the previous
# efti4eu/domibus image used by the li and platform instances.

ARG DOMIBUS_IMAGE=code.europa.eu:4567/edelivery/docker/domibus-tomcat10:5.2.1-JEE10

FROM ${DOMIBUS_IMAGE} AS build

# The provisioning helpers are bash scripts and reference optional variables unset, so run them
# under bash without `set -u`.
SHELL ["/bin/bash", "-c"]

# prepareDomibusConf() unpacks the Domibus distribution (configuration + WAR + default plugins +
# sample keystores + policies + internal/activemq.xml) into DOMIBUS_CONFIG_LOCATION. It needs no
# database, no message broker and no network, so it is safe to run at image build time.
RUN set -ex; \
    . /data/domInstall/scripts/common.functions; \
    mkdir -p "${DOMIBUS_CONFIG_LOCATION}"; \
    cd "${DOMIBUS_CONFIG_LOCATION}"; \
    prepareDomibusConf "tomcat"

# Deploy the WAR the same way the upstream entrypoint's deployDomibus() does.
RUN set -ex; \
    unzip -q "/data/domInstall/domibus/domibus-msh-distribution-${DOMIBUS_VERSION}-tomcat-war.zip" \
        -d "${CATALINA_HOME}/webapps"; \
    mv "${CATALINA_HOME}/webapps/domibus-MSH-tomcat-${DOMIBUS_VERSION}.war" \
       "${CATALINA_HOME}/webapps/domibus.war"

# Only the WS plugin is configured for this deployment (see e.g. domibus/sybo/plugins-conf). Shipping the
# FS/JMS/REST plugin JARs as well would start their schedulers and backend connectors with no
# matching configuration, producing constant authentication and "location folder is not set" errors.
RUN set -ex; \
    cd "${DOMIBUS_CONFIG_LOCATION}/plugins/lib"; \
    find . -name '*.jar' ! -name 'domibus-default-ws-plugin-*.jar' -delete; \
    cd "${DOMIBUS_CONFIG_LOCATION}/plugins/config"; \
    find . -maxdepth 1 -name '*-plugin.properties' ! -name 'ws-plugin.properties' -delete

# The distribution's default domain template points at keystores that are only generated by the
# provisioning we are deliberately skipping, and leaves placeholder values for the private key alias
# and store passwords. Domibus is configured for multi-tenancy here and always instantiates a
# "default" domain, so give it the distribution's sample gateway stores and the schema name this
# deployment actually creates. This domain is otherwise unused.
RUN set -ex; \
    cd "${DOMIBUS_CONFIG_LOCATION}/domains/default"; \
    cp "${DOMIBUS_CONFIG_LOCATION}/keystores/gateway_keystore.jks" default_keystore.jks; \
    cp "${DOMIBUS_CONFIG_LOCATION}/keystores/gateway_truststore.jks" default_truststore.jks; \
    sed -i \
        -e 's#^default\.domibus\.security\.keystore\.location=.*#default.domibus.security.keystore.location=${domibus.config.location}/domains/default/default_keystore.jks#' \
        -e 's#^default\.domibus\.security\.truststore\.location=.*#default.domibus.security.truststore.location=${domibus.config.location}/domains/default/default_truststore.jks#' \
        -e 's#^default\.domibus\.security\.keystore\.password=.*#default.domibus.security.keystore.password=test123#' \
        -e 's#^default\.domibus\.security\.truststore\.password=.*#default.domibus.security.truststore.password=test123#' \
        -e 's#^default\.domibus\.security\.key\.private\.password=.*#default.domibus.security.key.private.password=test123#' \
        -e 's#^default\.domibus\.security\.key\.private\.alias=.*#default.domibus.security.key.private.alias=blue_gw#' \
        -e 's#^default\.domibus\.database\.schema=.*#default.domibus.database.schema=default_schema#' \
        default-domibus.properties

# Activate the multitenancy include hooks for our domains. The fragments themselves live in the
# repository (e.g. domibus/sybo/domains/<domain>/<domain>-logback.xml) and are bind-mounted along with
# the rest of each domain's configuration.
# TODO EREF-79: can we make this domain agnostic?
RUN set -ex; \
    cd "${DOMIBUS_CONFIG_LOCATION}"; \
    for domain in syldavia borduria; do \
        sed -i "/<!-- multitenancy: end include domains config files here -->/i\\    <include optional=\"true\" file=\"\${catalina.home}/conf/domibus/domains/${domain}/${domain}-logback.xml\"/>" \
            logback.xml; \
    done

# prepareDomibusConf() also unpacks a copy of the WAR and an empty webapps/ directory into the
# configuration location; neither is used once the WAR is deployed under CATALINA_HOME/webapps.
RUN set -ex; \
    cd "${DOMIBUS_CONFIG_LOCATION}"; \
    rm -rf webapps domibus-MSH-tomcat-*.war domains/domain_name

FROM eclipse-temurin:21-jre

ENV CATALINA_HOME=/opt/domibus
ENV DOMIBUS_CONFIG_LOCATION=${CATALINA_HOME}/conf/domibus
ENV PATH=${CATALINA_HOME}/bin:${PATH}

COPY --from=build /data/tomcat ${CATALINA_HOME}

RUN mkdir -p "${CATALINA_HOME}/logs" "${CATALINA_HOME}/temp" "${CATALINA_HOME}/work"

WORKDIR ${CATALINA_HOME}
EXPOSE 8080

CMD ["catalina.sh", "run"]
